# Cloudflare Pages response headers.
# Kept in the repo so the security posture is reviewable and version-controlled
# rather than clicked into a dashboard.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # The motion libraries load from jsDelivr and the two webfonts from Google.
  # No inline script is used, so script-src needs no 'unsafe-inline'.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/app.js
  Cache-Control: public, max-age=3600, must-revalidate

/data.js
  Cache-Control: public, max-age=3600, must-revalidate

/BUILD-INFO.txt
  Cache-Control: no-store
